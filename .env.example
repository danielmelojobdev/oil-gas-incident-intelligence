# =============================================================================
# Oil & Gas Incident Intelligence — environment template
# Copy to .env (backend) and apps/mobile/.env (mobile) and fill in.
# NEVER commit real secrets. NEVER put a secret in an EXPO_PUBLIC_* variable.
# =============================================================================

# -----------------------------------------------------------------------------
# RUNTIME MODE
# -----------------------------------------------------------------------------
# full  -> real news providers + real AI provider + Postgres
# mock  -> MockNewsProvider + MockAIProvider + in-memory DB (no API keys, no cost)
APP_MODE=mock
NODE_ENV=development
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# BACKEND HTTP
# -----------------------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
# Comma separated list of allowed origins for CORS ("*" only in development)
CORS_ORIGINS=*
# Shared secret required by privileged endpoints (POST /v1/scans, /v1/admin/*)
ADMIN_API_TOKEN=change-me-in-production
# Requests per minute per IP
RATE_LIMIT_PER_MINUTE=120

# -----------------------------------------------------------------------------
# SUPABASE / POSTGRES  (server-side only — the service role key never ships to the app)
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection used by the scanner (Supabase: Settings > Database > Connection string)
DATABASE_URL=
# memory | postgres
DATABASE_DRIVER=memory

# -----------------------------------------------------------------------------
# AI PROVIDER  (keys are backend-only)
# -----------------------------------------------------------------------------
# mock | openai | anthropic | gemini
AI_PROVIDER=mock
AI_CLASSIFY_MODEL=
AI_EXTRACT_MODEL=
AI_MAX_CONCURRENCY=4
AI_TIMEOUT_MS=45000
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# NEWS SOURCE PROVIDERS  (comma separated; unavailable ones are skipped with a warning)
# mock,rss,google-news-rss,gdelt,bing-news,google-cse,newsapi
# -----------------------------------------------------------------------------
NEWS_PROVIDERS=mock
NEWS_API_KEY=
BING_API_KEY=
BING_ENDPOINT=https://api.bing.microsoft.com/v7.0/news/search
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
HTTP_USER_AGENT=OilGasIncidentIntelligence/0.1 (+contact@example.com)
HTTP_TIMEOUT_MS=15000
HTTP_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# SCANNER
# -----------------------------------------------------------------------------
# hourly | every-3-hours | every-6-hours | daily | off
SCAN_SCHEDULE=every-6-hours
SCAN_ENABLED=true
SCAN_MAX_QUERIES=40
SCAN_MAX_ARTICLES_PER_QUERY=25
SCAN_MAX_AI_EXTRACTIONS=40
SCAN_DEFAULT_PERIOD=last_30_days
# Minimum gap between user-triggered "Scan Now" runs (the admin token bypasses it)
SCAN_MANUAL_COOLDOWN_SECONDS=300

# -----------------------------------------------------------------------------
# PUSH NOTIFICATIONS
# -----------------------------------------------------------------------------
# mock | expo
PUSH_PROVIDER=mock
EXPO_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# MOBILE  (apps/mobile/.env — EXPO_PUBLIC_* is embedded in the app bundle: public only!)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_DATA_MODE=mock
EXPO_PUBLIC_API_URL=http://localhost:8787
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
