# Mobile environment. EXPO_PUBLIC_* is embedded in the app bundle: PUBLIC VALUES ONLY.
# Never put a service role key, an AI key or a news API key in this file.

# mock | api
EXPO_PUBLIC_DATA_MODE=mock

# Scanner backend base URL (only used when EXPO_PUBLIC_DATA_MODE=api)
EXPO_PUBLIC_API_URL=http://localhost:8787

# Supabase anon key is designed to be public and is guarded by RLS.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
